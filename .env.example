# Configuração de Conexão com o PostgreSQL (Neon Serverless ou Local)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_restaurante?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/saas_restaurante?schema=public"

# Portas dos Servidores
PORT=3001
NEXT_PUBLIC_API_URL="http://localhost:3001"
NODE_ENV=development
